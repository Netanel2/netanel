using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.Linq;
using ClosedXML.Excel;

// ============================================================================
//  RetroSplitter
//  ------------------------------------------------------------------------
//  קורא קובץ נתונים (TSV/CSV) עם 3 עמודות: קרן | תאריך רטרו | pt_party_no
//  מקבץ את הישויות לפי תאריך הרטרו, ומייצר:
//    1) קובץ אקסל נפרד לכל תאריך  ->  <פלט>\לפי_תאריך\רטרו_yyyy-MM.xlsx
//    2) קובץ מאסטר מרכזי           ->  <פלט>\ישויות_לפי_תאריך_רטרו_מאסטר.xlsx
//       (גיליון סיכום + גיליון כל-הישויות + גיליון לכל תאריך)
//
//  תלות אחת: ClosedXML  (NuGet:  Install-Package ClosedXML)
// ============================================================================

namespace RetroSplitter
{
    internal class Row
    {
        public string Keren;
        public string Date;      // כמחרוזת מקורית dd/MM/yyyy
        public DateTime Dt;      // לצורך מיון כרונולוגי
        public string Entity;
    }

    internal static class Program
    {
        // צבע כותרת + פונט — תואמים לקובץ שהופק
        private static readonly XLColor HeaderFill = XLColor.FromHtml("#1F3864");
        private const string FontName = "Arial";

        private static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            // אפשר להעביר בשורת הפקודה:  RetroSplitter.exe "C:\...\data.tsv" "C:\...\פלט"
            // ואם לא — נשאל את המשתמש כאן:
            string inputPath = args.Length > 0
                ? args[0]
                : Prompt("נתיב לקובץ הנתונים (TSV/CSV)", @"C:\Temp\data.tsv");

            string outputDir = args.Length > 1
                ? args[1]
                : Prompt("תיקייה לשמירת הפלט", @"C:\Temp\פלט_רטרו");

            try
            {
                if (!File.Exists(inputPath))
                    throw new FileNotFoundException("קובץ הקלט לא נמצא", inputPath);

                var rows = LoadRows(inputPath);
                if (rows.Count == 0)
                    throw new Exception("לא נמצאו שורות תקינות בקובץ.");

                Console.WriteLine(
                    $"נטענו {rows.Count} שורות | " +
                    $"{rows.Select(r => r.Entity).Distinct().Count()} ישויות | " +
                    $"{rows.Select(r => r.Date).Distinct().Count()} תאריכים.");

                Directory.CreateDirectory(outputDir);
                int files = WritePerDateFiles(rows, outputDir);
                string master = WriteMasterWorkbook(rows, outputDir);

                Console.WriteLine($"נוצרו {files} קבצים לפי תאריך.");
                Console.WriteLine($"נוצר קובץ מאסטר: {master}");
                Console.WriteLine("הסתיים בהצלחה.");
            }
            catch (Exception ex)
            {
                Console.WriteLine("שגיאה: " + ex.Message);
            }

            Console.WriteLine("לחץ Enter ליציאה...");
            Console.ReadLine();
        }

        // ------------------------------------------------------------------
        //  קריאת הקובץ. מזהה מפריד (טאב או פסיק) ומדלג על שורת כותרת אוטומטית
        //  (כל שורה שהתאריך בה לא ניתן לפירוק — מדולגת).
        // ------------------------------------------------------------------
        private static List<Row> LoadRows(string path)
        {
            var rows = new List<Row>();
            foreach (var raw in File.ReadAllLines(path))
            {
                if (string.IsNullOrWhiteSpace(raw)) continue;

                char sep = raw.Contains('\t') ? '\t' : ',';
                var parts = raw.Split(sep);
                if (parts.Length < 3) continue;

                string keren = parts[0].Trim();
                string date = parts[1].Trim();
                string entity = parts[2].Trim();

                if (!DateTime.TryParseExact(date, "dd/MM/yyyy",
                        CultureInfo.InvariantCulture, DateTimeStyles.None, out DateTime dt))
                    continue; // כותרת או שורה לא תקינה

                rows.Add(new Row { Keren = keren, Date = date, Dt = dt, Entity = entity });
            }

            // מיון כרונולוגי לפי תאריך ואז לפי מספר ישות
            return rows
                .OrderBy(r => r.Dt)
                .ThenBy(r => long.TryParse(r.Entity, out long n) ? n : long.MaxValue)
                .ToList();
        }

        // ------------------------------------------------------------------
        //  קובץ אקסל נפרד לכל תאריך
        // ------------------------------------------------------------------
        private static int WritePerDateFiles(List<Row> rows, string outputDir)
        {
            string dir = Path.Combine(outputDir, "לפי_תאריך");
            Directory.CreateDirectory(dir);

            var byDate = rows.GroupBy(r => r.Date)
                             .OrderBy(g => g.First().Dt);

            int count = 0;
            foreach (var g in byDate)
            {
                using (var wb = new XLWorkbook())
                {
                    var ws = wb.Worksheets.Add(SafeSheetName(g.Key));
                    FillSheet(ws, g.ToList());

                    DateTime dt = g.First().Dt;
                    string fileName = $"רטרו_{dt:yyyy-MM}.xlsx";
                    wb.SaveAs(Path.Combine(dir, fileName));
                }
                count++;
            }
            return count;
        }

        // ------------------------------------------------------------------
        //  קובץ מאסטר: סיכום + כל-הישויות + גיליון לכל תאריך
        // ------------------------------------------------------------------
        private static string WriteMasterWorkbook(List<Row> rows, string outputDir)
        {
            string masterPath = Path.Combine(outputDir, "ישויות_לפי_תאריך_רטרו_מאסטר.xlsx");

            using (var wb = new XLWorkbook())
            {
                var byDate = rows.GroupBy(r => r.Date)
                                 .OrderBy(g => g.First().Dt)
                                 .ToList();

                // --- גיליון סיכום ---
                var sum = wb.Worksheets.Add("סיכום לפי תאריך");
                sum.RightToLeft = true;
                StyleHeader(sum, new[] { "תאריך רטרו", "מספר ישויות" });
                int r = 2;
                foreach (var g in byDate)
                {
                    sum.Cell(r, 1).Value = g.Key;
                    sum.Cell(r, 2).Value = g.Count();
                    r++;
                }
                sum.Cell(r, 1).Value = "סה\"כ";
                sum.Cell(r, 1).Style.Font.Bold = true;
                sum.Cell(r, 2).FormulaA1 = $"SUM(B2:B{r - 1})";
                sum.Cell(r, 2).Style.Font.Bold = true;
                sum.Columns(1, 2).Width = 16;
                sum.SheetView.FreezeRows(1);
                StyleBody(sum, 2, r, 2);

                // --- גיליון כל הישויות ---
                var all = wb.Worksheets.Add("כל הישויות לפי תאריך");
                FillSheet(all, rows);

                // --- גיליון לכל תאריך ---
                foreach (var g in byDate)
                {
                    var ws = wb.Worksheets.Add(SafeSheetName(g.Key));
                    FillSheet(ws, g.ToList());
                }

                wb.SaveAs(masterPath);
            }
            return masterPath;
        }

        // ------------------------------------------------------------------
        //  עזרי עיצוב
        // ------------------------------------------------------------------
        private static readonly string[] Headers =
            { "קרן", "תאריך רטרו", "pt_party_no (ישות טופז)" };

        private static void FillSheet(IXLWorksheet ws, List<Row> data)
        {
            ws.RightToLeft = true;
            StyleHeader(ws, Headers);

            int r = 2;
            foreach (var row in data)
            {
                ws.Cell(r, 1).Value = row.Keren;
                ws.Cell(r, 2).Value = row.Date;
                ws.Cell(r, 3).Value = row.Entity;
                r++;
            }

            ws.Column(1).Width = 10;
            ws.Column(2).Width = 16;
            ws.Column(3).Width = 22;
            ws.SheetView.FreezeRows(1);
            StyleBody(ws, 2, r - 1, 3);
        }

        private static void StyleHeader(IXLWorksheet ws, string[] headers)
        {
            for (int c = 0; c < headers.Length; c++)
                ws.Cell(1, c + 1).Value = headers[c];

            var h = ws.Range(1, 1, 1, headers.Length);
            h.Style.Fill.BackgroundColor = HeaderFill;
            h.Style.Font.Bold = true;
            h.Style.Font.FontColor = XLColor.White;
            h.Style.Font.FontName = FontName;
            h.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            h.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
            h.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            h.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
        }

        private static void StyleBody(IXLWorksheet ws, int firstRow, int lastRow, int cols)
        {
            if (lastRow < firstRow) return;
            var body = ws.Range(firstRow, 1, lastRow, cols);
            body.Style.Font.FontName = FontName;
            body.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            body.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            body.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            body.Style.Border.OutsideBorderColor = XLColor.FromHtml("#BFBFBF");
            body.Style.Border.InsideBorderColor = XLColor.FromHtml("#BFBFBF");
        }

        // שם גיליון חוקי: ללא / \ ? * [ ] : ובאורך עד 31 תווים
        private static string SafeSheetName(string date)
        {
            string s = date.Replace('/', '-');
            foreach (char bad in new[] { '\\', '?', '*', '[', ']', ':' })
                s = s.Replace(bad.ToString(), "-");
            return s.Length > 31 ? s.Substring(0, 31) : s;
        }

        private static string Prompt(string label, string def)
        {
            Console.Write($"{label} [{def}]: ");
            string val = Console.ReadLine();
            return string.IsNullOrWhiteSpace(val) ? def : val.Trim().Trim('"');
        }
    }
}
