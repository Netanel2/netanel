.wrapper{max-width:1100px}.portal-hero{position:relative;overflow:hidden;padding:34px;border:1px solid #443c2d;border-radius:20px;background:radial-gradient(ellipse at 0% 0%,#353022 0%,transparent 55%),linear-gradient(120deg,#1d2028,#111318);margin-bottom:26px}.portal-kicker{font-size:11px;letter-spacing:2px;color:var(--gold-main);font-weight:700}.portal-hero h2{font-size:clamp(26px,4vw,42px);margin:12px 0;font-weight:650}.portal-hero p{color:#b1b5c0;max-width:600px;line-height:1.7;margin:0 0 18px}.portal-stats{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px}.portal-stats strong{display:block;color:var(--gold-main);font-size:23px}.portal-stats small{color:var(--text-muted)}.portal-heading{display:flex;align-items:center;gap:12px;margin:26px 0 12px;font-size:15px;color:var(--text-main)}.portal-heading:after{content:'';height:1px;background:var(--border-color);flex:1}.portal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.portal-card{font:inherit;text-align:right;cursor:pointer;display:flex;flex-direction:column;align-items:stretch;gap:10px;min-height:155px;padding:19px;background:var(--panel-bg);color:var(--text-main);border:1px solid var(--border-color);border-radius:14px;transition:transform .2s,border-color .2s,background .2s}.portal-card:hover{transform:translateY(-3px);border-color:var(--gold-main);background:#1b1e25}.portal-card-top{display:flex;align-items:center;justify-content:space-between}.portal-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:10px;background:#29251e;color:var(--gold-main);font-size:19px;font-weight:600;direction:ltr}.portal-card strong{font-size:16px}.portal-card small{color:var(--text-muted);font-size:13px;line-height:1.5}.portal-arrow{color:var(--gold-main);font-size:20px}.portal-actions{display:flex;gap:10px;flex-wrap:wrap}.portal-secondary{border:1px solid #44404a;background:transparent;color:var(--text-main);border-radius:10px;padding:10px 16px;font:inherit;cursor:pointer}.portal-secondary:hover{border-color:var(--gold-main)}@media(max-width:760px){.portal-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:480px){.portal-grid{grid-template-columns:1fr}.portal-hero{padding:22px}}
</style>
</head>
<body>
<div class="wrapper">
    <!-- Header -->
    <header>
        <div class="title-area">
            <h1>SQL Toolkit</h1>
            <div class="gold-dot"></div>
        </div>
        <p class="subtitle">בונה רשימות IN · מסדר קוד · משווה · קודי AL · בונה SQL מ-XML · תבניות שאילתה · ספריית SQL. הכל רץ מקומית בדפדפן.</p>
    </header>

    <!-- Tabs Navigation -->
    <div class="tabs">
                <button class="tab-btn active" onclick="switchTab('home-tab')">⌂ דף הבית</button>
        <button class="tab-btn" onclick="switchTab('saved-sql-tab')">שאילתות SQL</button>
        <button class="tab-btn" onclick="switchTab('in-builder')">IN Builder</button>
        <button class="tab-btn" onclick="switchTab('beautify')">Beautify</button>
        <button class="tab-btn" onclick="switchTab('compare')">Compare</button>
        <button class="tab-btn" onclick="switchTab('employees')">עובדים</button>
        <button class="tab-btn" onclick="switchTab('xml-sql')">XML→SQL</button>
        <button class="tab-btn" onclick="switchTab('templates-tab')">תבניות שאילתות</button>
        <button class="tab-btn" onclick="switchTab('unicode-tab')">Unicode ⇄ מלל</button>

    </div>
<section id="home-tab" class="tab-content active"><div class="portal-hero"><div class="portal-kicker">SQL TOOLKIT / WORKSPACE</div><h2>כל הכלים. מקום אחד.</h2><p>מרחב עבודה משותף לצוותים ולמחלקות. בחרו את הכלי המתאים למשימה והתחילו לעבוד.</p><div class="portal-stats"><div><strong>8</strong><small>כלי עבודה</small></div><div><strong id="homeCategories">–</strong><small>קטגוריות בספרייה</small></div><div><strong id="homeQueries">–</strong><small>שאילתות שמורות</small></div><div><strong>100%</strong><small>עבודה מקומית</small></div></div></div><h3 class="portal-heading">מסדי נתונים ושאילתות</h3><div class="portal-grid"><button type="button" class="portal-card" onclick="switchTab('saved-sql-tab')"><span class="portal-card-top"><span class="portal-icon">▤</span><span class="portal-arrow">←</span></span><strong>ספריית שאילתות SQL</strong><small>חיפוש, שמירה וארגון שאילתות לפי קטגוריות</small></button><button type="button" class="portal-card" onclick="switchTab('templates-tab')"><span class="portal-card-top"><span class="portal-icon">▦</span><span class="portal-arrow">←</span></span><strong>בונה שאילתות</strong><small>יצירת SELECT ו־UPDATE לפי טבלאות ושדות</small></button><button type="button" class="portal-card" onclick="switchTab('in-builder')"><span class="portal-card-top"><span class="portal-icon">( )</span><span class="portal-arrow">←</span></span><strong>IN Builder</strong><small>הכנת רשימות ערכים לשימוש בשאילתות</small></button></div><h3 class="portal-heading">פיתוח, אינטגרציה ותמיכה</h3><div class="portal-grid"><button type="button" class="portal-card" onclick="switchTab('beautify')"><span class="portal-card-top"><span class="portal-icon">{ }</span><span class="portal-arrow">←</span></span><strong>Beautify</strong><small>סידור וקריאות קוד SQL, JSON ו־XML</small></button><button type="button" class="portal-card" onclick="switchTab('compare')"><span class="portal-card-top"><span class="portal-icon">±</span><span class="portal-arrow">←</span></span><strong>Compare</strong><small>השוואת גרסאות וזיהוי הבדלים בטקסט</small></button><button type="button" class="portal-card" onclick="switchTab('xml-sql')"><span class="portal-card-top"><span class="portal-icon">⇄</span><span class="portal-arrow">←</span></span><strong>XML → SQL</strong><small>המרת XML ו־FetchXML לשאילתות SQL</small></button><button type="button" class="portal-card" onclick="switchTab('unicode-tab')"><span class="portal-card-top"><span class="portal-icon">א</span><span class="portal-arrow">←</span></span><strong>Unicode ⇄ מלל</strong><small>פענוח וקידוד טקסט ותווים</small></button></div><h3 class="portal-heading">תפעול וניהול עובדים</h3><div class="portal-grid"><button type="button" class="portal-card" onclick="switchTab('employees')"><span class="portal-card-top"><span class="portal-icon">AL</span><span class="portal-arrow">←</span></span><strong>כלי עובדים</strong><small>הפקת קודי AL ושאילתות לפי רשימות עובדים</small></button></div></section>
    <!-- כלי 1: IN Builder -->
    <div id="in-builder" class="tab-content">
        <div class="card">
            <div class="card-header">
                <span class="card-label">קלט ערכים (ערך אחד בכל שורה)</span>
            </div>
            <textarea id="inInput" placeholder="123
456
789"></textarea>
        </div>

           <div class="controls">
            <label class="checkbox-toggle">
                <input type="checkbox" id="wrapQuotes" checked>
                <span>הוסף גרשיים סביב ערכים (' ')</span>
            </label>
            <label class="checkbox-toggle">
                <input type="checkbox" id="wrapParentheses" checked>
                <span>עטוף בסוגריים ( )</span>
            </label>
            <label class="checkbox-toggle">
                <input type="checkbox" id="padZeros">
                <span>השלם ל-9 ספרות עם אפסים (0)</span>
            </label>
            <button type="button" class="btn-main" onclick="generateInBuilder()">צור פלט</button>
        </div>


        <div class="card">
            <div class="card-header">
                <span class="card-label">פלט מוכן ל-SQL</span>
                <button type="button" class="btn-copy" onclick="copyText('inOutput', this)">העתק</button>
            </div>
            <div id="inOutput" class="out"></div>
        </div>
    </div>

    <!-- כלי 2: Beautify -->
    <div id="beautify" class="tab-content">
        <div class="card">
            <div class="card-header">
                <span class="card-label">קוד מקור לבלאגן (SQL / JSON / XML)</span>
            </div>
            <textarea id="beautifyInput" placeholder="select id,name from users where status=1 and type='client'"></textarea>
        </div>

        <div class="controls">
            <div class="segment-control" id="beautifyTypeGroup">
                <button type="button" class="segment-btn active" onclick="setBeautifyType('auto', this)">Auto</button>
                <button type="button" class="segment-btn" onclick="setBeautifyType('sql', this)">SQL</button>
                <button type="button" class="segment-btn" onclick="setBeautifyType('json', this)">JSON</button>
                <button type="button" class="segment-btn" onclick="setBeautifyType('xml', this)">XML</button>
            </div>
            <button type="button" class="btn-main" onclick="processBeautify()">סדר קוד</button>
        </div>

        <div id="beautifyError" class="error-message"></div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">קוד מיושר ומסודר</span>
                <button type="button" class="btn-copy" onclick="copyText('beautifyOutput', this)">העתק</button>
            </div>
            <div id="beautifyOutput" class="out"></div>
        </div>
    </div>

    <!-- כלי 3: Compare -->
    <div id="compare" class="tab-content">
        <div class="compare-grid">
            <div class="card" style="margin-bottom:0;">
                <div class="card-header"><span class="card-label">טקסט מקורי (ישן)</span></div>
                <textarea id="diffOriginal" placeholder="הדבק כאן את הטקסט הישן..."></textarea>
            </div>
            <div class="card" style="margin-bottom:0;">
                <div class="card-header"><span class="card-label">טקסט מעודכן (חדש)</span></div>
                <textarea id="diffModified" placeholder="הדבק כאן את הטקסט החדש..."></textarea>
            </div>
        </div>

        <div class="controls">
            <button type="button" class="btn-main" onclick="processDiff()">מצא הבדלים</button>
        </div>

        <div class="card">
            <div class="card-header"><span class="card-label">תוצאת ההשוואה הוויזואלית</span></div>
            <div id="diffOutput" class="compare-view">התוצאה הוויזואלית תופיע כאן...</div>
        </div>
    </div>

    <!-- כלי 4: עובדים (AL Generator) המשודרג עם הפקת שאילתות SQL -->
    <div id="employees" class="tab-content">
        <div class="card">
            <div class="card-header">
                <span class="card-label">רשימת עובדים (מזהה | שם | משפחה | משפחה אנגלית | שם אנגלית | מייל)</span>
            </div>
            <textarea id="alInput" placeholder="107513	שירז רבקה	כוכבי	Kohavi	Shiraz	shirazk@altshul.co.il"></textarea>
        </div>

        <div class="controls">
            <button type="button" class="btn-main" onclick="generateAlRows()">צור רשימות AL ושאילתות</button>
        </div>

        <div id="alError" class="error-message"></div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">פלט משולב (שורה אחר שורה)</span>
                <button type="button" class="btn-copy" onclick="copyText('alOutputCombined', this)">העתק</button>
            </div>
            <div id="alOutputCombined" class="out"></div>
        </div>

        <div class="compare-grid">
            <div class="card" style="margin-bottom:0;">
                <div class="card-header">
                    <span class="card-label">AL אותיות בלבד</span>
                    <button type="button" class="btn-copy" onclick="copyText('alOutputLetters', this)">העתק</button>
                </div>
                <div id="alOutputLetters" class="out"></div>
            </div>
            <div class="card" style="margin-bottom:0;">
                <div class="card-header">
                    <span class="card-label">AL מספרים בלבד</span>
                    <button type="button" class="btn-copy" onclick="copyText('alOutputNumbers', this)">העתק</button>
                </div>
                <div id="alOutputNumbers" class="out"></div>
            </div>
        </div>

        <!-- תיבת פלט 1: שאילתת SQL מאוחדת -->
        <div class="card" style="margin-top: 20px;">
            <div class="card-header">
                <span class="card-label">שאילתת SQL מאוחדת (לכל העובדים יחד)</span>
                <button type="button" class="btn-copy" onclick="copyText('alSqlCombined', this)">העתק שאילתה</button>
            </div>
            <div id="alSqlCombined" class="out"></div>
        </div>

        <!-- תיבת פלט 2: שאילתות SQL נפרדות -->
        <div class="card">
            <div class="card-header">
                <span class="card-label">שאילתות SQL נפרדות (לכל עובד בנפרד)</span>
                <button type="button" class="btn-copy" onclick="copyText('alSqlIndividual', this)">העתק שאילתות</button>
            </div>
            <div id="alSqlIndividual" class="out"></div>
        </div>
    </div>
    <!-- כלי 5: XML ל-SQL -->
    <div id="xml-sql" class="tab-content">
        <div class="hint-box">
            מנוע המרה חכם: מזהה אוטומטית <strong>FetchXML</strong> של Dynamics CRM וממיר ל-<code>SELECT</code>, או <strong>XML נתונים</strong> וממיר ל-<code>INSERT</code> / <code>CREATE TABLE</code> / <code>SELECT</code>.
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">הדבק קוד XML מקור</span>
            </div>
            <textarea id="xmlInput" placeholder="<fetch>
  
    <attribute name=&quot;fullname&quot; />
  
</fetch>"></textarea>
        </div>

        <div class="controls">
            <select id="xmlSqlDialect">
                <option value="tsql">SQL Server ([Column])</option>
                <option value="mysql">MySQL (`Column`)</option>
                <option value="ansi">Standard SQL (Column)</option>
            </select>

            <select id="xmlSqlAction">
                <option value="auto">פעולה: זיהוי אוטומטי</option>
                <option value="insert">INSERT INTO</option>
                <option value="create">CREATE TABLE</option>
                <option value="select">SELECT FROM</option>
            </select>

            <label class="checkbox-toggle">
                <input type="checkbox" id="xmlNullEmpty" checked>
                <span>המר ערך ריק ל-NULL</span>
            </label>

            <button type="button" class="btn-main" onclick="processXmlToSql()">בנה שאילתה</button>
        </div>

        <div id="xmlSqlError" class="error-message"></div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">שאילתת SQL מיוצרת</span>
                <button type="button" class="btn-copy" onclick="copyText('xmlSqlOutput', this)">העתק</button>
            </div>
            <div id="xmlSqlOutput" class="out"></div>
        </div>
    </div>

    <!-- כלי 6: בונה שאילתות דינמי לפי טבלאות -->
    <div id="templates-tab" class="tab-content">
        <div class="hint-box">
            בונה שאילתות חכם: בחר טבלה, סמן את העמודות שברצונך לשלוף (SELECT) ואת העמודות לפיהן תרצה לסנן (WHERE), מלא את הערכים והעתק שאילתה מוכנה.
        </div>

        <div class="compare-grid" style="grid-template-columns: 260px 1fr;">
            <!-- תפריט צדדי: בחירת טבלה -->
            <div class="card" style="margin-bottom:0; max-height: 500px; overflow-y: auto;">
                <div class="card-header"><span class="card-label">בחר טבלת יעד</span></div>
                <div id="tablesNav" style="padding: 12px; display: flex; flex-direction: column; gap: 8px;">
                    <!-- רשימת הטבלאות תיווצר כאן דינמית ע"י ה-JS -->
                </div>
            </div>

            <!-- אזור בניית השאילתה -->
            <div style="display: flex; flex-direction: column; gap: 20px;">
                <div class="card" style="margin-bottom:0;">
                    <div class="card-header">
                        <span class="card-label" id="selectedTableTitle">אנא בחר טבלה מהתפריט הימני</span>
                    </div>
                    
                    <!-- אזור הבנייה הדינמי של הצ'קבוקסים -->
                    <div id="builderColumnsArea" style="padding: 16px; border-bottom: 1px solid var(--border-color); background-color: var(--panel-header-bg); display: none; flex-direction: column; gap: 20px;">
                        <!-- ייווצרו כאן התיבות והשדות הדינמיים ל-SET ול-WHERE ע"י ה-JS -->
                    </div>
                    
                    <!-- תצוגת השאילתות המוכנות להעתקה -->
                    <div class="card-header" style="border-top: 1px solid var(--border-color); border-bottom: none;">
                        <span class="card-label" style="color: var(--gold-main)">1. שאילתת שליפה ובדיקה (SELECT)</span>
                        <button type="button" class="btn-copy" onclick="copyText('builderSelectOutputCode', this)">העתק SELECT</button>
                    </div>
                    <div id="builderSelectOutputCode" class="out" style="min-height: 100px; background-color: #0c0d10; border-bottom: 1px solid var(--border-color);"></div>

                    <div class="card-header" style="border-bottom: none;">
                        <span class="card-label" style="color: #f56565">2. שאילתת עדכון נתונים (UPDATE)</span>
                        <button type="button" class="btn-copy" onclick="copyText('builderUpdateOutputCode', this)">העתק UPDATE</button>
                    </div>
                    <div id="builderUpdateOutputCode" class="out" style="min-height: 100px; background-color: #0c0d10;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- כלי 7: Unicode ⇄ מלל (מפענח/מקודד רצפי בריחה) -->
    <div id="unicode-tab" class="tab-content">
        <div class="hint-box">
            ממיר טקסט מקודד ל-<strong>מלל קריא</strong> ולהפך. בפענוח מזהה
            <code>\uXXXX</code>, <code>\u{XXXX}</code>, <code>\xXX</code>,
            ישויות HTML (<code>&amp;#1489;</code> / <code>&amp;#x5D1;</code>),
            קידוד URL (<code>%D7%91</code>) ובריחות JSON נפוצות (<code>\n</code>, <code>\t</code>).
        </div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">קלט</span>
            </div>
            <textarea id="uniInput" dir="ltr" placeholder="\u05d1\u05d5\u05d2\u05e0\u05d9\u05dd \u05e2\u05d9\u05d3\u05d9\u05ea"></textarea>
        </div>

        <div class="controls">
            <div class="segment-control" id="uniModeGroup">
                <button type="button" class="segment-btn active" onclick="setUniMode('decode', this)">פענוח ← מלל</button>
                <button type="button" class="segment-btn" onclick="setUniMode('encode', this)">קידוד → \u</button>
            </div>
            <button type="button" class="btn-main" onclick="processUnicode()">המר</button>
        </div>

        <div id="uniError" class="error-message"></div>

        <div class="card">
            <div class="card-header">
                <span class="card-label">תוצאה</span>
                <button type="button" class="btn-copy" onclick="copyText('uniOutput', this)">העתק</button>
            </div>
            <div id="uniOutput" class="out wrap-soft"></div>
        </div>
    </div>

    <div id="saved-sql-tab" class="tab-content">
      <div class="lib-top"><div><h2>ספריית שאילתות SQL</h2><p>כל השאילתות שלך, במקום אחד.</p></div><div class="controls" style="margin:0"><button type="button" class="btn-main" onclick="libCategory()">＋ קטגוריה חדשה</button><button type="button" class="btn-main" onclick="libEdit(true)">＋ שאילתה חדשה</button></div></div>
      <div class="lib-search"><input id="libSearch" placeholder="חיפוש לפי שם, מילת מפתח או קוד SQL…" oninput="libRender()"><button class="segment-btn" onclick="document.getElementById('libSearch').value='';libRender()">נקה</button></div>
      <div class="lib-grid">
        <aside class="card lib-side"><div class="card-header"><span class="card-label">קטגוריות</span></div><div id="libCats"></div><div style="padding:0 12px 12px"><button type="button" class="btn-main" style="width:100%" onclick="libCategory()">＋ קטגוריה חדשה</button></div><div class="card-header"><span class="card-label">שאילתות</span><span id="libCount" class="card-meta"></span></div><div id="libList"></div></aside>
        <main class="card lib-detail"><div id="libEmpty" class="hint-box" style="margin:16px">בחר שאילתה מהרשימה או צור שאילתה חדשה.</div><div id="libDetail" hidden>
          <div class="lib-detail-head"><small id="libBadge"></small><h2 id="libTitle"></h2><p id="libDescription"></p><div class="controls"><button class="segment-btn" onclick="libEdit(false)">עריכה</button><button class="segment-btn" onclick="libDelete()">מחיקה</button></div></div>
          <div id="libParams" style="padding:16px;border-top:1px solid var(--border-color)" hidden><strong style="color:var(--gold-main)">משתני חיפוש</strong><div class="compare-grid" style="margin:12px 0"><div class="param-field-group"><label for="crmEntitySearch">שם ישות / טבלה · @EntitySearch</label><input id="crmEntitySearch" maxlength="98" dir="ltr" placeholder="account" oninput="updateCrmQuery()"></div><div class="param-field-group"><label for="crmFieldSearch">שם שדה · @FieldSearch</label><input id="crmFieldSearch" maxlength="98" dir="ltr" placeholder="statuscode" oninput="updateCrmQuery()"></div></div><small>חיפוש חלקי אוטומטי. שדה ריק לצד שדה מלא מחפש הכל.</small> <button class="segment-btn" onclick="resetCrmQuery()">איפוס</button></div>
