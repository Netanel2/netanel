<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SQL Toolkit</title>
    <style>
        :root {
            --bg-main: #0c0d10;
            --panel-bg: #15171c;
            --panel-header-bg: #1b1e25;
            --border-color: #262a33;
            --text-main: #e8e9ed;
            --text-muted: #8b8f9a;
            --gold-main: #d4af6a;
            --gold-hover: #b8954e;
            --code-text: #9fd3c7;
            --placeholder-color: #4b505b;
            --success-color: #3fae8e;
            --success-text: #04140f;
            --error-color: #e53e3e;
            --error-bg: #fff5f5;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Heebo, system-ui, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            padding: 32px 20px 60px;
            direction: rtl;
            text-align: right;
            display: flex;
            justify-content: center;
        }

        .wrapper {
            width: 100%;
            max-width: 900px;
        }
        /* Header Style */
        header {
            margin-bottom: 24px;
        }

        .title-area {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: var(--text-main);
            margin: 0;
        }

        .gold-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--gold-main);
            display: inline-block;
        }

        .subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin: 0;
        }

        /* Tabs System */
        .tabs {
            display: flex;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 24px;
            gap: 16px;
            overflow-x: auto;
        }

        .tab-btn {
            background: transparent;
            border: none;
            padding: 10px 4px;
            font-size: 14px;
            color: var(--text-muted);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-main);
        }

        .tab-btn.active {
            color: var(--gold-main);
            border-bottom-color: var(--gold-main);
            font-weight: 500;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Card Framework */
        .card {
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .card-header {
            background-color: var(--panel-header-bg);
            padding: 12px 16px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-label {
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .card-meta {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Controls & Form Elements */
        .controls {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin: 4px 0 20px;
        }

        .checkbox-toggle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background-color: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            color: var(--text-muted);
            font-size: 13px;
            cursor: pointer;
            user-select: none;
        }

        .checkbox-toggle input {
            accent-color: var(--gold-main);
            cursor: pointer;
        }

        .segment-control {
            display: flex;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            overflow: hidden;
            background-color: var(--panel-bg);
        }

        .segment-btn {
            background: transparent;
            border: none;
            padding: 8px 14px;
            font-size: 13px;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .segment-btn.active {
            background-color: var(--gold-main);
            color: #1a1407;
            font-weight: 600;
        }

        select {
            background-color: var(--panel-bg);
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            cursor: pointer;
        }

        select:focus {
            border-color: var(--gold-hover);
        }

        /* Text Input & Display Area */
        textarea {
            width: 100%;
            height: 180px;
            min-height: 160px;
            background: transparent;
            border: none;
            padding: 16px;
            color: var(--text-main);
            font-family: SFMono-Regular, ui-monospace, 'JetBrains Mono', Menlo, monospace;
            font-size: 14px;
            direction: ltr;
            text-align: left;
            resize: vertical;
            outline: none;
        }

        textarea::placeholder {
            color: var(--placeholder-color);
        }

        .out {
            font-family: SFMono-Regular, ui-monospace, 'JetBrains Mono', Menlo, monospace;
            color: var(--code-text);
            direction: ltr;
            text-align: left;
            white-space: pre;
            overflow-x: auto;
            min-height: 62px;
            padding: 16px;
            background: transparent;
        }

        .out.wrap-soft {
            white-space: pre-wrap;
            word-break: break-word;
        }
        /* Action Buttons */
        button.btn-main {
            background-color: var(--gold-main);
            color: #1a1407;
            border: none;
            font-weight: 600;
            font-size: 14px;
            padding: 10px 22px;
            border-radius: 10px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button.btn-main:hover {
            background-color: var(--gold-hover);
        }

        button.btn-copy {
            background-color: var(--gold-main);
            color: #1a1407;
            border: none;
            font-size: 13px;
            padding: 8px 16px;
            border-radius: 9px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.2s;
        }

        button.btn-copy.copied {
            background-color: var(--success-color);
            color: var(--success-text);
        }

        /* Hint Box */
        .hint-box {
            background-color: var(--panel-header-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.65;
            margin-bottom: 20px;
        }

        .hint-box strong {
            color: var(--text-main);
        }

        .hint-box code {
            font-family: SFMono-Regular, ui-monospace, monospace;
            color: var(--code-text);
            background: rgba(159, 211, 199, .08);
            padding: 2px 7px;
            border-radius: 6px;
            direction: ltr;
            display: inline-block;
            font-size: 12px;
        }

        .hint-arrow {
            color: var(--gold-main);
            margin: 0 4px;
            font-weight: bold;
        }

        /* Compare Grid Layout */
        .compare-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-bottom: 20px;
        }

        /* סגנונות מיוחדים ללשונית תבניות */
        .template-cat-title {
            font-size: 13px;
            font-weight: 600;
            color: var(--gold-main);
            margin: 12px 0 6px;
            padding-bottom: 4px;
            border-bottom: 1px solid rgba(212, 175, 106, 0.15);
        }
        .template-item-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            text-align: right;
            padding: 8px 10px;
            font-size: 13px;
            cursor: pointer;
            border-radius: 7px;
            transition: all 0.2s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            width: 100%;
        }
        .template-item-btn:hover {
            background-color: var(--panel-header-bg);
            color: var(--text-main);
        }
        .template-item-btn.active {
            background-color: rgba(212, 175, 106, 0.1);
            color: var(--gold-main);
            font-weight: 500;
        }
        .param-field-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .param-field-group label {
            font-size: 12px;
            color: var(--text-muted);
        }
        .param-field-group input {
            background-color: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
        }
        .param-field-group input:focus {
            border-color: var(--gold-main);
        }

        .compare-view {
            background-color: #111317;
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 16px;
            font-family: SFMono-Regular, ui-monospace, monospace;
            font-size: 14px;
            white-space: pre-wrap;
            word-break: break-all;
            line-height: 1.5;
            min-height: 180px;
            direction: ltr;
            text-align: left;
        }

        .diff-added {
            background-color: rgba(63, 174, 142, 0.15);
            color: #53cbaf;
            text-decoration: none;
            padding: 2px 4px;
            border-radius: 4px;
        }

        .diff-removed {
            background-color: rgba(229, 62, 62, 0.15);
            color: #f56565;
            text-decoration: line-through;
            padding: 2px 4px;
            border-radius: 4px;
        }

        .error-message {
            display: none;
            background-color: rgba(229, 62, 62, 0.1);
            color: #f56565;
            border: 1px solid #5a2020;
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: 500;
            font-size: 13px;
        }

        footer {
            text-align: center;
            margin-top: 26px;
            color: #454a55;
            font-size: 12px;
        }

        @media (max-width: 640px) {
            .compare-grid {
                grid-template-columns: 1fr;
            }
        }
		        /* צביעת קוד דינמית (Syntax Highlighting) */
        .hl-keyword { color: #ff79c6; font-weight: 600; } /* מילות מפתח - ורוד */
        .hl-string  { color: #50fa7b; } /* ערכי טקסט בגרשיים - ירוק */
        .hl-tag     { color: #ffb86c; } /* תגיות XML/HTML - כתום מוזהב */
        .hl-attr    { color: #8be9fd; } /* שדות ותכונות - תכלת */
        .hl-comment { color: #6272a4; font-style: italic; } /* הערות - אפור כחלחל */
        .hl-number  { color: #bd93f9; } /* מספרים - סגול */

        /* ============================================================
           UX ENHANCEMENTS · אפקטים ומיקרו-אינטראקציות
           הכל מקומי לחלוטין · אפס קריאות רשת · אפס ספריות חיצוניות
           ============================================================ */

        /* רקע אטמוספרי עדין עם זוהר זהב/טורקיז */
        body {
            background-color: var(--bg-main);
            background-image:
                radial-gradient(900px 520px at 88% -12%, rgba(212,175,106,0.06), transparent 60%),
                radial-gradient(760px 620px at -12% 112%, rgba(159,211,199,0.045), transparent 55%);
            background-attachment: fixed;
        }

        /* כניסה רכה של כל הממשק בטעינה */
        .wrapper { animation: appReveal .55s cubic-bezier(.22,.61,.36,1) both; }
        @keyframes appReveal {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* נקודת הזהב — נשימה עדינה */
        .gold-dot { animation: goldPulse 2.8s ease-in-out infinite; }
        @keyframes goldPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(212,175,106,0); transform: scale(1); }
            50%      { box-shadow: 0 0 14px 2px rgba(212,175,106,.45); transform: scale(1.18); }
        }

        /* טאבים — קו תחתון מונפש שמחליק */
        .tab-btn { position: relative; }
        .tab-btn::after {
            content: "";
            position: absolute;
            inset-inline: 0; bottom: -1px;
            height: 2px; border-radius: 2px;
            background: var(--gold-main);
            transform: scaleX(0);
            transition: transform .28s cubic-bezier(.4,0,.2,1);
        }
        .tab-btn.active::after { transform: scaleX(1); box-shadow: 0 0 10px rgba(212,175,106,.55); }
        .tab-btn.active { border-bottom-color: transparent; }

        /* תוכן טאב — כניסה עדינה בכל מעבר */
        .tab-content.active { animation: tabIn .35s cubic-bezier(.22,.61,.36,1) both; }
        @keyframes tabIn {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* כרטיסים — הרמה והדגשת מסגרת ב-hover, מסגרת זהב כשעובדים בתוכם */
        .card {
            transition: border-color .25s ease, box-shadow .3s ease, transform .25s ease;
            box-shadow: 0 1px 0 rgba(255,255,255,.02) inset, 0 4px 18px -12px rgba(0,0,0,.7);
        }
        .card:hover {
            border-color: #333949;
            box-shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 14px 40px -20px rgba(0,0,0,.85);
        }
        .card:focus-within {
            border-color: rgba(212,175,106,.5);
            box-shadow: 0 0 0 1px rgba(212,175,106,.18), 0 14px 40px -22px rgba(0,0,0,.9);
        }

        /* שדות קלט — טבעת פוקוס זהב רכה */
        textarea, .param-field-group input, select {
            transition: box-shadow .2s ease, border-color .2s ease, background-color .2s ease;
        }
        textarea:focus { box-shadow: inset 0 0 0 1px rgba(212,175,106,.28); }
        .param-field-group input:focus, select:focus { box-shadow: 0 0 0 3px rgba(212,175,106,.12); }

        /* כפתור פעולה ראשי — גרדיאנט עדין + הרמה + זוהר */
        button.btn-main {
            background-image: linear-gradient(180deg, #ddbb78, var(--gold-main));
        }
        button.btn-main:hover { background-image: linear-gradient(180deg, #e3c486, var(--gold-hover)); }

        button.btn-main, button.btn-copy {
            position: relative; overflow: hidden;
            transition: transform .12s ease, box-shadow .25s ease, background-color .2s ease, filter .2s ease;
            box-shadow: 0 6px 16px -8px rgba(212,175,106,.55);
        }
        button.btn-main:hover, button.btn-copy:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px -8px rgba(212,175,106,.7);
            filter: brightness(1.04);
        }
        button.btn-main:active, button.btn-copy:active {
            transform: translateY(0) scale(.97);
            box-shadow: 0 4px 10px -6px rgba(212,175,106,.5);
        }
        button.btn-copy.copied {
            box-shadow: 0 0 0 3px rgba(63,174,142,.25), 0 8px 20px -8px rgba(63,174,142,.6);
        }

        /* גל לחיצה (Ripple) */
        .ripple {
            position: absolute; border-radius: 50%;
            background: rgba(26,20,7,.35);
            transform: scale(0); pointer-events: none;
            animation: rippleAnim .55s ease-out;
        }
        @keyframes rippleAnim { to { transform: scale(2.6); opacity: 0; } }

        /* segment + checkbox feedback */
        .segment-btn { transition: background-color .2s ease, color .2s ease, box-shadow .2s ease; }
        .segment-btn.active { box-shadow: inset 0 0 0 1px rgba(255,255,255,.1); }
        .checkbox-toggle { transition: border-color .2s ease, background-color .2s ease, color .2s ease; }
        .checkbox-toggle:hover { border-color: #333949; color: var(--text-main); }
        .checkbox-toggle:has(input:checked) {
            border-color: rgba(212,175,106,.45);
            color: var(--text-main);
            background-color: rgba(212,175,106,.06);
        }

        /* תיבות פלט — הבזק עדין כשנוצר תוכן חדש */
        .out.flash, .compare-view.flash { animation: outFlash .9s ease-out; }
        @keyframes outFlash {
            0%   { background-color: rgba(212,175,106,.10); }
            100% { background-color: transparent; }
        }

        /* פריטי תבניות — תזוזה עדינה ב-hover */
        .template-item-btn { transition: background-color .18s ease, color .18s ease, padding-inline-start .18s ease; }
        .template-item-btn:hover { padding-inline-start: 16px; }

        /* פס גלילה מותאם לערכה הכהה */
        * { scrollbar-width: thin; scrollbar-color: #2c313c transparent; }
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb {
            background: #2c313c; border-radius: 8px;
            border: 2px solid transparent; background-clip: content-box;
        }
        ::-webkit-scrollbar-thumb:hover { background: #3a4150; background-clip: content-box; }

        /* טוסט הודעות צף */
        #toastHost {
            position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
            display: flex; flex-direction: column; gap: 8px; z-index: 9999; pointer-events: none;
        }
        .toast {
            background: var(--panel-header-bg);
            border: 1px solid rgba(212,175,106,.35);
            color: var(--text-main);
            padding: 10px 16px; border-radius: 10px; font-size: 13px;
            box-shadow: 0 16px 40px -16px rgba(0,0,0,.9);
            display: flex; align-items: center; gap: 8px;
            animation: toastIn .3s cubic-bezier(.22,.61,.36,1);
        }
        .toast .toast-ic { color: var(--success-color); font-weight: 700; }
        .toast.leaving { animation: toastOut .3s ease forwards; }
        @keyframes toastIn  { from { opacity:0; transform: translateY(12px) scale(.96);} to { opacity:1; transform: translateY(0) scale(1);} }
        @keyframes toastOut { to { opacity:0; transform: translateY(12px) scale(.96);} }

        /* פוקוס מקלדת ברור (נגישות) */
        :focus-visible { outline: 2px solid var(--gold-main); outline-offset: 2px; border-radius: 4px; }

        /* כיבוד העדפת תנועה מופחתת */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; transition: none !important; }
        }

        /* תיקון רספונסיביות במסכים צרים — מונע גלישה אופקית בלשונית התבניות.
           ה-!important נדרש כדי לגבור על סגנונות ה-inline שמוגדרים על הרשת. */
        @media (max-width: 640px) {
            body { padding-left: 14px; padding-right: 14px; }
            #templates-tab .compare-grid { grid-template-columns: 1fr !important; }
            #templates-tab .card[style*="max-height"] { max-height: 280px !important; }
            /* שורות בונה השאילתה (נוצרות דינמית עם רשת 3 עמודות) — מיושרות לעמודה אחת */
            #builderColumnsArea > div { grid-template-columns: 1fr !important; gap: 8px !important; }
        }

    
