        var t = document.createElement('div');
        t.className = 'toast';
        t.innerHTML = '<span class="toast-ic">✓</span><span></span>';
        t.lastChild.textContent = msg;
        host().appendChild(t);
        setTimeout(function(){
            t.classList.add('leaving');
            setTimeout(function(){ t.remove(); }, 320);
        }, 1700);
    }
    /* חשיפת הטוסט ל-copyText — מופעל רק כשההעתקה הצליחה בפועל */
    window.showCopyToast = showToast;

    /* ---- אפקט גל לחיצה ---- */
    document.addEventListener('click', function(e){
        if (reduceMotion) return;
        var btn = e.target.closest('button.btn-main, button.btn-copy, .segment-btn, .tab-btn');
        if (!btn) return;
        var rect = btn.getBoundingClientRect();
        var size = Math.max(rect.width, rect.height);
        var r = document.createElement('span');
        r.className = 'ripple';
        r.style.width = r.style.height = size + 'px';
        r.style.left = (e.clientX - rect.left - size / 2) + 'px';
        r.style.top  = (e.clientY - rect.top  - size / 2) + 'px';
        if (btn.classList.contains('tab-btn') || btn.classList.contains('segment-btn')) {
            r.style.background = 'rgba(212,175,106,.30)';
        }
        btn.appendChild(r);
        setTimeout(function(){ r.remove(); }, 600);
    }, true);

    /* ---- הבזק עדין בכל פעם שתיבת פלט מתעדכנת ---- */
    function watchOutputs(){
        var boxes = document.querySelectorAll('.out, .compare-view');
        boxes.forEach(function(box){
            var obs = new MutationObserver(function(){
                if (box.textContent.trim().length) {
                    box.classList.remove('flash');
                    void box.offsetWidth; /* reflow כדי לאתחל את האנימציה */
                    box.classList.add('flash');
                }
            });
            obs.observe(box, { childList: true, characterData: true, subtree: true });
        });
    }

    document.addEventListener('DOMContentLoaded', function(){
        watchOutputs();
    });
})();
</script>
<script>
const crmQueryTemplate = "DECLARE @EntitySearch NVARCHAR(100) = N'%שם טבלה%'; \nDECLARE @FieldSearch NVARCHAR(100) = N'%שם שדה%'; \n\nSELECT \n    e.Name AS [שם_ישות_בCRM],\n    e.BaseTableName AS [טבלת_בסיס_בSQL],\n    a.Name AS [שם_שדה_לוגי],\n    at.Description AS [סוג_השדה],\n    ll_he.Label AS [תווית_בעברית],\n    ll_en.Label AS [תווית_באנגלית],\n    -- שליפת ערכים בעברית או באנגלית כגיבוי\n    STUFF((\n        SELECT DISTINCT ' | ' + CAST(sm.AttributeValue AS VARCHAR(20)) + ' = ' + sm.Value\n        FROM dbo.StringMapBase AS sm WITH (NOLOCK)\n        WHERE sm.ObjectTypeCode = e.ObjectTypeCode\n          AND sm.AttributeName = a.Name\n          AND sm.LangId IN (1037, 1033)\n        FOR XML PATH(''), TYPE\n    ).value('.', 'NVARCHAR(MAX)'), 1, 3, '') AS [מפת_ערכים]\nFROM MetadataSchema.Attribute AS a WITH (NOLOCK)\nINNER JOIN MetadataSchema.Entity AS e WITH (NOLOCK)\n    ON a.EntityId = e.EntityId\nLEFT JOIN MetadataSchema.AttributeTypes AS at WITH (NOLOCK)\n    ON a.AttributeTypeId = at.AttributeTypeId\nLEFT JOIN MetadataSchema.LocalizedLabel AS ll_he WITH (NOLOCK)\n    ON a.AttributeId = ll_he.ObjectId \n    AND ll_he.ObjectColumnName = 'DisplayName' \n    AND ll_he.LanguageId = 1037\nLEFT JOIN MetadataSchema.LocalizedLabel AS ll_en WITH (NOLOCK)\n    ON a.AttributeId = ll_en.ObjectId \n    AND ll_en.ObjectColumnName = 'DisplayName' \n    AND ll_en.LanguageId = 1033\nWHERE (e.Name LIKE @EntitySearch OR e.BaseTableName LIKE @EntitySearch)\n  AND a.Name LIKE @FieldSearch\n  AND e.IsIntersect = 0\nORDER BY e.Name, a.Name;";
const libKey='sqlToolkit.library.v1';
const libDefault=()=>({categories:[{id:'bam',name:'בע״מ'}],queries:[{id:'crm',cat:'bam',name:'חיפוש עמודות ב CRM בע"מ',desc:'חיפוש ישויות, טבלאות, שדות, תוויות ומפת ערכים ב-Dynamics CRM',code:crmQueryTemplate,params:true}]});
let libData=libDefault(),libFilter='all',libSelected='crm',libEditing=null;
const libEl=id=>document.getElementById(id);
try{const saved=localStorage.getItem(libKey);if(saved)libData=libValidate(JSON.parse(saved));}catch(e){libEl('libStatus').textContent='לא ניתן לטעון את האחסון המקומי; מומלץ לייצא גיבוי.';}
function libValidate(x){if(!x||!Array.isArray(x.categories)||!Array.isArray(x.queries))throw Error('גיבוי לא תקין');const cats=new Set(),qs=new Set();for(const c of x.categories){if(typeof c.id!=='string'||c.id==='all'||cats.has(c.id)||typeof c.name!=='string'||!c.name.trim())throw Error('קטגוריה לא תקינה');cats.add(c.id)}for(const q of x.queries){if(typeof q.id!=='string'||qs.has(q.id)||!cats.has(q.cat)||typeof q.name!=='string'||typeof q.code!=='string'||typeof q.desc!=='string')throw Error('שאילתה לא תקינה');qs.add(q.id)}return x;}
function libSave(){try{localStorage.setItem(libKey,JSON.stringify(libData));libEl('libStatus').textContent='השינויים נשמרו מקומית · מומלץ לייצא גיבוי';}catch(e){libEl('libStatus').textContent='השמירה המקומית נכשלה — ייצא גיבוי לפני סגירה!';}}
function libId(){return Date.now().toString(36)+'-'+Math.random().toString(36).slice(2)}
function libButton(label,count,active,fn){const b=document.createElement('button');b.type='button';b.className='lib-item'+(active?' active':'');const t=document.createElement('span');t.textContent=label;b.append(t);if(count!==null){const c=document.createElement('small');c.textContent=count;b.append(c)}b.onclick=fn;return b}
function libRender(){const cats=libEl('libCats'),list=libEl('libList');cats.replaceChildren();list.replaceChildren();cats.append(libButton('כל השאילתות',libData.queries.length,libFilter==='all',()=>{libFilter='all';libRender()}));for(const c of libData.categories){const row=document.createElement('div');row.className='lib-cat-row';row.append(libButton(c.name,libData.queries.filter(q=>q.cat===c.id).length,libFilter===c.id,()=>{libFilter=c.id;libRender()}));const edit=document.createElement('button');edit.className='segment-btn';edit.textContent='⋯';edit.title='שינוי שם קטגוריה';edit.onclick=()=>libCategory(c.id);row.append(edit);cats.append(row)}const terms=libEl('libSearch').value.toLowerCase().trim().split(/\s+/).filter(Boolean);const matches=libData.queries.filter(q=>(libFilter==='all'||q.cat===libFilter)&&terms.every(t=>(q.name+' '+q.desc+' '+q.code).toLowerCase().includes(t)));libEl('libCount').textContent=matches.length+' תוצאות';if(!matches.some(q=>q.id===libSelected))libSelected=matches[0]?.id||null;for(const q of matches)list.append(libButton(q.name,null,q.id===libSelected,()=>{libSelected=q.id;resetCrmQuery();libRender()}));if(!matches.length){const p=document.createElement('p');p.style.padding='8px';p.style.color='var(--text-muted)';p.textContent='אין שאילתות מתאימות';list.append(p)}libShow();}
function libShow(){const q=libData.queries.find(q=>q.id===libSelected);libEl('libEmpty').hidden=!!q;libEl('libDetail').hidden=!q;if(!q)return;libEl('libTitle').textContent=q.name;libEl('libBadge').textContent=libData.categories.find(c=>c.id===q.cat)?.name||'';libEl('libDescription').textContent=q.desc;libEl('libParams').hidden=!q.params;updateCrmQuery();}
function updateCrmQuery(){const q=libData.queries.find(q=>q.id===libSelected);if(!q)return;let sql=q.code;const entity=libEl('crmEntitySearch').value.trim(),field=libEl('crmFieldSearch').value.trim();const pattern=v=>(v?'%'+v+'%':'%').replace(/'/g,"''");if(q.params&&(entity||field))sql=sql.replace(/(DECLARE\s+@(EntitySearch|FieldSearch)\s+NVARCHAR\(100\)\s*=\s*)N'(?:''|[^'])*'/gi,(_,prefix,k)=>prefix+"N'"+pattern(k.toLowerCase()==='entitysearch'?entity:field)+"'");libEl('crmQueryOutput').value=sql;}
function resetCrmQuery(){libEl('crmEntitySearch').value='';libEl('crmFieldSearch').value='';updateCrmQuery();}
let libCategoryEditing=null,libAfterCategory=false;
function libCategory(id,after=false){const c=libData.categories.find(c=>c.id===id);libCategoryEditing=c?.id||null;libAfterCategory=after;libEl('libCategoryTitle').textContent=c?'שינוי שם קטגוריה':'קטגוריה חדשה';libEl('libCategoryName').value=c?.name||'';libEl('libCategoryError').hidden=true;libEl('libCategoryDialog').showModal();libEl('libCategoryName').focus();}
libEl('libCategoryForm').addEventListener('submit',e=>{e.preventDefault();const name=libEl('libCategoryName').value.trim(),err=libEl('libCategoryError');if(!name||libData.categories.some(c=>c.id!==libCategoryEditing&&c.name.toLowerCase()===name.toLowerCase())){err.textContent=name?'קטגוריה בשם זה כבר קיימת':'יש להזין שם קטגוריה';err.hidden=false;return;}const c=libData.categories.find(c=>c.id===libCategoryEditing);if(c)c.name=name;else{libFilter=libId();libData.categories.push({id:libFilter,name});libEl('libSearch').value='';}libSave();libRender();libEl('libCategoryDialog').close();if(libAfterCategory)libEdit(true);});
function libEdit(isNew){const q=isNew?null:libData.queries.find(q=>q.id===libSelected);if(!isNew&&!q)return;if(!libData.categories.length){libCategory(undefined,true);return;}libEditing=q?.id||null;libEl('libFormTitle').textContent=q?'עריכת שאילתה':'שאילתה חדשה';libEl('libName').value=q?.name||'';libEl('libDesc').value=q?.desc||'';libEl('libCode').value=q?.code||'';const sel=libEl('libCat');sel.replaceChildren();for(const c of libData.categories){const o=document.createElement('option');o.value=c.id;o.textContent=c.name;sel.append(o)}sel.value=q?.cat||(libFilter==='all'?libData.categories[0].id:libFilter);libEl('libDialog').showModal();}
libEl('libForm').addEventListener('submit',e=>{e.preventDefault();const name=libEl('libName').value.trim(),code=libEl('libCode').value;if(!name||!code.trim())return alert('יש למלא שם וקוד');const old=libData.queries.find(q=>q.id===libEditing);const q={id:old?.id||libId(),cat:libEl('libCat').value,name,desc:libEl('libDesc').value.trim(),code,params:/DECLARE\s+@EntitySearch\s+NVARCHAR\(100\)\s*=\s*N'/i.test(code)&&/DECLARE\s+@FieldSearch\s+NVARCHAR\(100\)\s*=\s*N'/i.test(code)};if(old)Object.assign(old,q);else libData.queries.push(q);libSelected=q.id;libFilter=q.cat;libEl('libSearch').value='';resetCrmQuery();libSave();libEl('libDialog').close();libRender()});
function libDelete(){const q=libData.queries.find(q=>q.id===libSelected);if(q&&confirm('למחוק את '+q.name+'?')){libData.queries=libData.queries.filter(x=>x.id!==q.id);libSelected=null;libSave();libRender()}}
function libExport(){const url=URL.createObjectURL(new Blob([JSON.stringify(libData,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='SQL-Toolkit-library.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
async function libImportFile(input){try{if(!input.files[0])return;const data=libValidate(JSON.parse(await input.files[0].text()));if(!confirm('הייבוא יחליף את הספרייה הנוכחית. להמשיך?'))return;libData=data;libFilter='all';libSelected=null;libEl('libSearch').value='';libSave();libRender()}catch(e){alert('לא ניתן לייבא: '+e.message)}finally{input.value=''}}
function portalRefresh(){libEl('homeCategories').textContent=libData.categories.length;libEl('homeQueries').textContent=libData.queries.length;}
libRender();portalRefresh();
</script>
